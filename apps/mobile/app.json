{
  "expo": {
    "name": "Purpose Mobile",
    "slug": "purpose-mobile",
    "scheme": "purpose",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Purpose uses your location to tailor coaching when you ask Fermi for local context."
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-location"
    ]
  }
}
