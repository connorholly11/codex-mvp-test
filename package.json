{
  "name": "purpose-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:mobile\" --names \"web,mobile\" --prefix-colors \"blue,magenta\"",
    "dev:web": "NODE_OPTIONS=\"--require $INIT_CWD/scripts/load-env.cjs\" pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "lint": "pnpm lint:web",
    "lint:web": "pnpm --filter web lint",
    "lint:mobile": "pnpm --filter mobile lint",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^2.1.5"
  }
}
